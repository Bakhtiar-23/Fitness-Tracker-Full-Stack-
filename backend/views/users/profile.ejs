<!-- views/users/profile.ejs -->

<div class="container mt-5">
    <h1>User Profile</h1>

    <!-- Display user information -->
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Hello, <%= user.fullName %>!</h5>
            <p class="card-text"><strong>Email:</strong> <%= user.email %></p>
            <p class="card-text"><strong>Phone:</strong> <%= user.phoneNumber %></p>
            <p class="card-text"><strong>Zip Code:</strong> <%= user.zipCode %></p>
        </div>
    </div>

    <!-- Sign Out Button -->
    <a href="/users/logout" class="btn btn-danger mt-3">Sign Out</a>
</div>
