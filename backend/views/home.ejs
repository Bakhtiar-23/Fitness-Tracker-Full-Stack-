<% include layout %> <!-- Ensures layout structure is applied -->

<h2 class="videos-heading">Existing Videos</h2>
<div class="video-container">
  <% videos.forEach(video => { %>
    <div class="video-item">
      <iframe
        class="video-bg"
        src="<%= video.url %>"
        frameborder="0"
        allow="autoplay; fullscreen; encrypted-media"
        allowfullscreen
      ></iframe>
      <div class="video-overlay">
        <h3>Welcome to Fitness Tracker</h3>
        <p>Track your fitness journey and stay motivated!</p>
      </div>
    </div>
  <% }); %>
</div>

<div class="section-container">
  <section class="track-workouts">
    <h2>Track Your Workouts</h2>
    <p>Log your daily fitness activities and keep track of your progress! Stay motivated and reach your fitness goals.</p>
    <a href="/dashboard" class="btn btn-primary">Go to Track Your Workouts</a>
  </section>

  <section class="monitor-nutrition">
    <h2>Monitor Nutrition</h2>
    <p>Keep an eye on your diet and make healthier choices.</p>
    <a href="/dashboard" class="btn btn-primary">Healthier Choices</a>
  </section>

  <section class="set-goals">
    <h2>Set Goals</h2>
    <p>Set fitness goals and stay motivated to achieve them.</p>
    <a href="/dashboard" class="btn btn-primary">Set Goals</a>
  </section>
</div>

<section class="cta">
  <h2>Ready to start your fitness journey?</h2>
  <a href="/users/new" class="cta-button">Sign Up Now</a>
</section>
