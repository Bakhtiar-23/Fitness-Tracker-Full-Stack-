<div class="data-form"></div>

  <form action="/team-member/create" method="POST">
    <h2>Create a New Team Member</h2>
    <label for="inputFullName">Full Name</label>
    <input type="text" name="name" id="inputFulltName" placeholder="Name" autofocus required>
    <label for="inputRole">Role</label>
    <input type="text" name="role" id="inputRole" placeholder="Role" autofocus required>
    <label for="inputEmail">Email</label>
    <input type="email" name="email" id="inputEmail" placeholder="Email" autofocus required>
    <label for="inputExperience 'S">Experience</label>
    <input type="text" name="experience" id="inputExperience" placeholder="Experience">
    <input type="file" name="image" id="UploadImage">
    <button class="btn btn-lg btn-primary btn-block" type="submit">Submit</button>
  </form>

  