<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Videos</title>
  <!-- Link to the specific CSS file for the Add Video page -->
  <link rel="stylesheet" href="/css/add-video.css">
  <script>
    // JavaScript function to confirm the deletion
    function confirmDelete(event) {
      event.preventDefault();  // Prevent the form from submitting immediately
      const isConfirmed = confirm("Are you sure you want to delete this video?");
      
      // If confirmed, submit the form
      if (isConfirmed) {
        event.target.submit(); // This will submit the form
      }
    }
  </script>
</head>
<body>
  <h1>Manage Videos</h1>

  <!-- Add Video Form -->
  <form action="/add-video" method="POST">
    <label for="url">Video URL:</label>
    <input type="text" name="url" id="url" required>

    <label for="title">Video Title:</label>
    <input type="text" name="title" id="title" required>

    <button type="submit">Add Video</button>
  </form>

  <!-- Video List -->
  <h2>Existing Videos</h2>
  <table border="1" cellspacing="0" cellpadding="5">
    <thead>
      <tr>
        <th>Title</th>
        <th>Preview</th>
        <th>URL</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% videos.forEach(video => { %>
        <tr>
          <td><%= video.title %></td>
          <td>
            <iframe src="<%= video.url %>" width="200" height="150" frameborder="0" allowfullscreen></iframe>
          </td>
          <td><a href="<%= video.url %>" target="_blank">Watch</a></td>
          <td>
            <!-- Form to navigate to delete confirmation page -->
            <form action="/video/<%= video._id %>/delete" method="GET" style="display: inline;">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
